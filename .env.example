# Root .env.example - copy to .env and fill

# Database
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/mangadb?schema=public"

# JWT
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Backend
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=manga

# Prisma
# no extra here; Prisma uses DATABASE_URL

# App
DEFAULT_LANGUAGE=fa
